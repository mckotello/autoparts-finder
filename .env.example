# Ключ покупателя из личного кабинета Favorit Parts
VITE_API_KEY=00000000-0000-0000-0000-000000000001

# Базовый URL API (для прокси в dev). По умолчанию http://api.favorit-parts.ru
# VITE_API_BASE_URL=http://api.favorit-parts.ru

# В production без прокси Vite укажите полный URL (может не работать из‑за CORS)
# VITE_API_URL=http://api.favorit-parts.ru/hs/hsprice/
